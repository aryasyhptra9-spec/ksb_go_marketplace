/** Invoices bill only outstanding COD. Deducted commissions appear as statements, never charged twice. */
function ksbInvoicePeriod_(args){var start=String(args.start||''),end=String(args.end||'');ksbRequire_(/^\d{4}-\d{2}-\d{2}$/.test(start)&&/^\d{4}-\d{2}-\d{2}$/.test(end)&&end>=start,'Rentang periode tidak valid');return {start:start,end:end};}
function ksbAdminInvoices_(actor,args){ksbRole_(actor,'ADMIN');return ksbPagination_(ksbPageSort_(ksbRows_('INVOICES'),'created_at'),args);}
function ksbIssueInvoice_(actor,args){ksbRole_(actor,'ADMIN');return ksbIdempotent_(actor,'INVOICE',args.requestKey,function(){var period=ksbInvoicePeriod_(args),party=ksbRow_('USERS',args.partyId),type=String(args.partyType),cycle=String(args.cycle);ksbRequire_(party&&['SELLER','COURIER'].indexOf(type)>=0&&['DAILY','WEEKLY','MONTHLY'].indexOf(cycle)>=0,'Penerima/siklus invoice invalid');
  var existing=ksbFilter_('INVOICES',function(i){return i.party_id===party.id&&i.party_type===type&&i.period_start===period.start&&i.period_end===period.end&&i.cycle===cycle&&i.status!=='VOID';});ksbRequire_(!existing.length,'Invoice untuk mitra dan periode ini sudah ada.');
  var items=[];if(type==='COURIER'){var courier=ksbFilter_('COURIERS',function(c){return c.user_id===party.id;})[0];ksbRequire_(courier,'Mitra bukan kurir');ksbFilter_('COD_COLLECTIONS',function(c){return c.courier_id===courier.id&&Number(c.remaining_amount)>0&&c.collected_at.slice(0,10)>=period.start&&c.collected_at.slice(0,10)<=period.end;}).forEach(function(c){var previously=ksbFilter_('INVOICE_ITEMS',function(ii){if(ii.source_id!==c.id)return false;var inv=ksbRow_('INVOICES',ii.invoice_id);return inv&&inv.status!=='VOID'&&inv.status!=='PAID';}).length;if(!previously)items.push({source_type:'COD',source_id:c.id,description:'Setoran COD pengiriman '+c.delivery_id,amount:Number(c.remaining_amount)});});}
  var total=items.reduce(function(s,i){return s+i.amount;},0),id=ksbId_('INV'),now=ksbNow_(),due=String(args.dueDate||period.end);ksbRequire_(/^\d{4}-\d{2}-\d{2}$/.test(due),'Tanggal jatuh tempo harus YYYY-MM-DD');
  ksbAppend_('INVOICES',{id:id,party_id:party.id,party_type:type,period_start:period.start,period_end:period.end,cycle:cycle,invoice_type:type==='SELLER'?'STATEMENT':'COD_BILL',total:total,paid:0,balance:total,status:total===0?'PAID':'ISSUED',due_date:due,issued_at:now,created_at:now});items.forEach(function(i){ksbAppend_('INVOICE_ITEMS',{id:ksbId_('II'),invoice_id:id,source_type:i.source_type,source_id:i.source_id,description:i.description,amount:i.amount,created_at:now});});ksbAudit_(actor.id,'ISSUE_INVOICE','INVOICE',id,{total:total});return {id:id,total:total,status:total===0?'PAID':'ISSUED',items:items};
});}
function ksbPayInvoice_(actor,args){ksbRole_(actor,'ADMIN');return ksbIdempotent_(actor,'INVOICE_PAYMENT',args.requestKey,function(){var inv=ksbRow_('INVOICES',args.invoiceId);ksbRequire_(inv&&['ISSUED','PARTIALLY_PAID','OVERDUE'].indexOf(inv.status)>=0,'Invoice tidak bisa dibayar');var amount=ksbAmount_(args.amount,'Pembayaran');ksbRequire_(amount>0&&amount<=Number(inv.balance),'Nominal melebihi sisa tagihan');var ref=ksbString_(args.bankReference,100);ksbRequire_(ref,'Referensi mutasi bank wajib');ksbRequire_(!ksbFilter_('INVOICE_PAYMENTS',function(p){return p.bank_reference===ref;}).length,'Referensi sudah digunakan');ksbRequire_(args.confirmFunds===true,'Konfirmasi mutasi bank sebelum merekam setoran');
  var left=amount;ksbFilter_('INVOICE_ITEMS',function(i){return i.invoice_id===inv.id&&i.source_type==='COD';}).forEach(function(i){if(left<=0)return;var c=ksbRow_('COD_COLLECTIONS',i.source_id),p=Math.min(left,Number(c.remaining_amount));if(p>0){ksbPatch_('COD_COLLECTIONS',c.id,{remaining_amount:Number(c.remaining_amount)-p,status:Number(c.remaining_amount)-p===0?'RECONCILED':'PARTIAL',updated_at:ksbNow_()});left-=p;}});ksbRequire_(left===0,'Alokasi setoran COD gagal');var paymentId=ksbId_('IP');ksbJournal_('INVOICE_PAYMENT',paymentId,'','Setoran COD terverifikasi',[{account:'CASH_PLATFORM',debit:amount},{account:'COD_RECEIVABLE_COURIER',party_id:inv.party_id,credit:amount}]);ksbAppend_('INVOICE_PAYMENTS',{id:paymentId,invoice_id:inv.id,amount:amount,bank_reference:ref,verified_by:actor.id,created_at:ksbNow_()});var balance=Number(inv.balance)-amount;ksbPatch_('INVOICES',inv.id,{paid:Number(inv.paid)+amount,balance:balance,status:balance===0?'PAID':'PARTIALLY_PAID'});ksbFilter_('COD_COLLECTIONS',function(c){return c.courier_id&&Number(c.remaining_amount)===0;}).forEach(function(c){var pending=ksbFilter_('COD_COLLECTIONS',function(x){return x.order_id===c.order_id&&Number(x.remaining_amount)>0;});if(!pending.length){var o=ksbRow_('ORDERS',c.order_id);if(o&&o.payment_method==='COD'){ksbPatch_('ORDERS',o.id,{payment_status:'COD_RECONCILED'});ksbFilter_('PAYMENTS',function(p){return p.order_id===o.id&&p.method==='COD';}).forEach(function(p){ksbPatch_('PAYMENTS',p.id,{status:'COD_RECONCILED'});});}}});ksbAudit_(actor.id,'PAY_INVOICE','INVOICE',inv.id,{amount:amount});return {id:inv.id,balance:balance,status:balance===0?'PAID':'PARTIALLY_PAID'};
});}
