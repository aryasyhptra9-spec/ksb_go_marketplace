/** Optional scheduled invoices; only run against a verified configuration and after staging tests. */
function installBillingTrigger_(){var handlers=ScriptApp.getProjectTriggers().filter(function(t){return t.getHandlerFunction()==='runBillingCycle_';});handlers.forEach(function(t){ScriptApp.deleteTrigger(t);});ScriptApp.newTrigger('runBillingCycle_').timeBased().everyDays(1).atHour(7).inTimezone(KSB_CFG.TZ).create();return {installed:true,time:'sekitar 07.00 Asia/Makassar',frequency:'DAILY'};}
function ksbYmd_(date){return Utilities.formatDate(date,KSB_CFG.TZ,'yyyy-MM-dd');}
function ksbUtcShift_(ymd,days){var d=new Date(ymd+'T00:00:00Z');d.setUTCDate(d.getUTCDate()+days);return d.toISOString().slice(0,10);}
function ksbCyclePeriod_(ymd,cycle){var d=new Date(ymd+'T00:00:00Z'),dow=d.getUTCDay();if(cycle==='DAILY')return {start:ksbUtcShift_(ymd,-1),end:ksbUtcShift_(ymd,-1)};if(cycle==='WEEKLY'&&dow===1)return {start:ksbUtcShift_(ymd,-7),end:ksbUtcShift_(ymd,-1)};if(cycle==='MONTHLY'&&d.getUTCDate()===1)return {start:ksbUtcShift_(ymd,-1).slice(0,7)+'-01',end:ksbUtcShift_(ymd,-1)};return null;}
function runBillingCycle_(){var today=ksbYmd_(new Date()),adminEmail=ksbProperty_('ADMIN_EMAIL').toLowerCase(),admin=ksbFilter_('USERS',function(u){return u.email===adminEmail;})[0];ksbRequire_(admin,'Pemilik admin harus login sekali sebelum trigger aktif.');var actor={id:admin.id,roles:['ADMIN'],email:admin.email},out=[];
  [{table:'SELLERS',role:'SELLER'},{table:'COURIERS',role:'COURIER'}].forEach(function(kind){ksbFilter_(kind.table,function(r){return ksbBool_(r.verified);}).forEach(function(p){var cycle=p.billing_cycle||'MONTHLY',period=ksbCyclePeriod_(today,cycle);if(!period)return;var key='AUTO:'+kind.role+':'+p.user_id+':'+period.start+':'+period.end;try{out.push(ksbIssueInvoice_(actor,{partyId:p.user_id,partyType:kind.role,cycle:cycle,start:period.start,end:period.end,dueDate:ksbUtcShift_(period.end,7),requestKey:ksbSha_(key).slice(0,32)}));}catch(e){console.error('Auto invoice '+key+': '+e.message);}});});return {date:today,issued:out.length};
}
