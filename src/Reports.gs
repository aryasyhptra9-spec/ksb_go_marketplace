function ksbReports_(actor,args){ksbRole_(actor,'ADMIN');var from=String(args.from||'0000-01-01'),to=String(args.to||'9999-12-31');var orders=ksbFilter_('ORDERS',function(o){return o.created_at.slice(0,10)>=from&&o.created_at.slice(0,10)<=to;}),completed=orders.filter(function(o){return o.status==='DELIVERED';});return {orderCount:orders.length,completedCount:completed.length,gross:orders.reduce(function(s,o){return s+Number(o.grand_total);},0),completedGross:completed.reduce(function(s,o){return s+Number(o.grand_total);},0),orders:ksbPagination_(ksbPageSort_(orders,'created_at'),args)};}
