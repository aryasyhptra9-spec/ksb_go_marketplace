function ksbCatalog_(args){
  args=args||{};var q=String(args.q||'').trim().toLowerCase(),district=String(args.district||''),category=String(args.category||'');
  var stores=ksbRows_('SELLER_STORES'),byStore={};stores.forEach(function(s){byStore[s.id]=s;});
  var rows=ksbRows_('PRODUCTS').filter(function(p){var s=byStore[p.store_id];return ksbBool_(p.active)&&s&&s.status==='ACTIVE'&&(!q||(p.name+' '+s.name).toLowerCase().indexOf(q)>=0)&&(!district||s.district_id===district)&&(!category||p.category_id===category);}).map(function(p){var s=byStore[p.store_id],images=ksbFilter_('PRODUCT_IMAGES',function(i){return i.product_id===p.id&&!i.removed_at;});return {id:p.id,name:p.name,price:Number(p.price),stock:Number(p.stock),category_id:p.category_id,store_id:p.store_id,store_name:s.name,district_id:s.district_id,image:images.length?ksbImageUrl_(images[0].file_id):''};});
  rows=ksbPageSort_(rows,'id');return {products:ksbPagination_(rows,args),categories:ksbRows_('CATEGORIES').filter(function(x){return ksbBool_(x.active);}).map(function(c){return {id:c.id,name:c.name};})};
}
function ksbImageUrl_(fileId){return 'https://drive.google.com/thumbnail?id='+encodeURIComponent(fileId)+'&sz=w500';}
function ksbProductDetail_(args){var p=ksbRow_('PRODUCTS',args.id);ksbRequire_(p&&ksbBool_(p.active),'Produk tidak ditemukan');var s=ksbRow_('SELLER_STORES',p.store_id);ksbRequire_(s&&s.status==='ACTIVE','Toko tidak aktif');return {id:p.id,name:p.name,description:p.description,price:Number(p.price),stock:Number(p.stock),category_id:p.category_id,store:{id:s.id,name:s.name,address:s.address,district_id:s.district_id,lat:s.lat,lng:s.lng,whatsapp:s.whatsapp||''},images:ksbFilter_('PRODUCT_IMAGES',function(i){return i.product_id===p.id&&!i.removed_at;}).map(function(i){return ksbImageUrl_(i.file_id);}),variants:ksbFilter_('PRODUCT_VARIANTS',function(v){return v.product_id===p.id&&ksbBool_(v.active);}).map(function(v){return {id:v.id,name:v.name,price_delta:Number(v.price_delta),stock:Number(v.stock)};})};}
function ksbStoreGet_(actor){var store=ksbSellerStore_(actor);return {store:store,categories:ksbRows_('CATEGORIES')};}
function ksbStoreSave_(actor,args){ksbRole_(actor,'SELLER');var seller=ksbFilter_('SELLERS',function(x){return x.user_id===actor.id&&ksbBool_(x.verified);})[0];ksbRequire_(seller,'Seller belum diverifikasi.');return ksbWithLock_(function(){var data={name:ksbString_(args.name,120),description:ksbString_(args.description||'',1000),district_id:ksbString_(args.district_id,60),address:ksbString_(args.address,400),lat:ksbString_(args.lat||'',30),lng:ksbString_(args.lng||'',30),opening_time:ksbString_(args.opening_time||'08:00',5),closing_time:ksbString_(args.closing_time||'21:00',5),status:args.status==='INACTIVE'?'INACTIVE':'ACTIVE',whatsapp:ksbWhatsAppNumber_(args.whatsapp||'')};
  ksbRequire_(data.name&&data.address&&ksbRow_('DISTRICTS',data.district_id),'Lengkapi data toko.');
  ksbRequire_(/^\d{2}:\d{2}$/.test(data.opening_time)&&/^\d{2}:\d{2}$/.test(data.closing_time),'Jam toko harus HH:MM.');
  var old=ksbFilter_('SELLER_STORES',function(s){return s.seller_id===seller.id;})[0];if(old){ksbPatch_('SELLER_STORES',old.id,data);return ksbRow_('SELLER_STORES',old.id);}
  data.id=ksbId_('STR');data.seller_id=seller.id;data.created_at=ksbNow_();return ksbAppend_('SELLER_STORES',data);
});}
function ksbSellerProducts_(actor,args){var store=ksbSellerStore_(actor);return ksbPagination_(ksbPageSort_(ksbFilter_('PRODUCTS',function(p){return p.store_id===store.id;}),'created_at'),args);}
function ksbProductSave_(actor,args){var store=ksbSellerStore_(actor);ksbRequire_(store,'Buat toko terlebih dahulu.');return ksbWithLock_(function(){var product=args.id?ksbRow_('PRODUCTS',args.id):null;if(args.id)ksbRequire_(product&&product.store_id===store.id,'Produk bukan milik toko.');var price=ksbAmount_(args.price,'Harga'),stock=ksbAmount_(args.stock,'Stok');ksbRequire_(price>0,'Harga harus lebih dari 0');ksbRequire_(!!ksbRow_('CATEGORIES',args.category_id),'Kategori tidak ada');var data={name:ksbString_(args.name,160),description:ksbString_(args.description||'',2000),price:price,stock:stock,category_id:args.category_id,active:args.active===false?'FALSE':'TRUE',updated_at:ksbNow_()};ksbRequire_(data.name,'Nama produk diperlukan');if(product){ksbPatch_('PRODUCTS',product.id,data);ksbAudit_(actor.id,'UPDATE','PRODUCT',product.id,data);return ksbRow_('PRODUCTS',product.id);}data.id=ksbId_('PRD');data.store_id=store.id;data.created_at=ksbNow_();ksbAppend_('PRODUCTS',data);ksbAppend_('PRODUCT_VARIANTS',{id:ksbId_('VAR'),product_id:data.id,name:'Default',price_delta:0,stock:stock,active:'TRUE',created_at:ksbNow_()});ksbAudit_(actor.id,'CREATE','PRODUCT',data.id,{});return data;});}
function ksbAddressList_(actor){return ksbFilter_('ADDRESSES',function(a){return a.user_id===actor.id;});}
function ksbAddressSave_(actor,args){var old=args.id?ksbRow_('ADDRESSES',args.id):null;if(old)ksbRequire_(old.user_id===actor.id,'Akses alamat ditolak');var data={label:ksbString_(args.label||'Rumah',60),recipient:ksbString_(args.recipient,120),phone:ksbString_(args.phone,25),district_id:ksbString_(args.district_id,60),address:ksbString_(args.address,400),lat:ksbString_(args.lat||'',30),lng:ksbString_(args.lng||'',30),notes:ksbString_(args.notes||'',400)};ksbRequire_(data.recipient&&data.phone&&data.address&&ksbRow_('DISTRICTS',data.district_id),'Alamat belum lengkap');return ksbWithLock_(function(){if(old)return ksbPatch_('ADDRESSES',old.id,data);data.id=ksbId_('ADR');data.user_id=actor.id;data.created_at=ksbNow_();return ksbAppend_('ADDRESSES',data);});}
