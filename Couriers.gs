function ksbCourierProfile_(actor){var c=ksbOwnCourier_(actor);return {courier:c,user:ksbMe_(actor)};}
function ksbCourierOnline_(actor,args){var c=ksbOwnCourier_(actor),online=args.online===true?'TRUE':'FALSE';ksbPatch_('COURIERS',c.id,{online:online});return {online:online==='TRUE'};}
function ksbAvailableDeliveries_(actor,args){var c=ksbOwnCourier_(actor);ksbRequire_(ksbBool_(c.online),'Aktifkan status online untuk melihat order.');return ksbPagination_(ksbPageSort_(ksbFilter_('DELIVERY_ORDERS',function(d){return d.status==='AVAILABLE';}),'created_at').map(function(d){return {id:d.id,type:d.type,from_district:d.from_district,to_district:d.to_district,shipping_fee:d.shipping_fee,status:d.status,created_at:d.created_at};}),args);}
function ksbMyDeliveries_(actor,args){var c=ksbOwnCourier_(actor);return ksbPagination_(ksbPageSort_(ksbFilter_('DELIVERY_ORDERS',function(d){return d.courier_id===c.id;}),'created_at'),args);}
/** Global ScriptLock serializes competing courier claims; no max in-delivery limit. */
function ksbClaimDelivery_(actor,args){ksbV10RequireCommerce_();var c=ksbOwnCourier_(actor);return ksbWithLock_(function(){c=ksbRow_('COURIERS',c.id);ksbRequire_(ksbBool_(c.online),'Kurir harus online');var busy=ksbFilter_('DELIVERY_ORDERS',function(d){return d.courier_id===c.id&&KSB_CFG.CLAIM_PENDING.indexOf(d.status)>=0;});ksbRequire_(!busy.length,'Ambil paket dari seller/pengirim terlebih dahulu sebelum klaim berikutnya.');var d=ksbRow_('DELIVERY_ORDERS',args.deliveryId);ksbRequire_(d&&d.status==='AVAILABLE'&&!d.courier_id,'Order sudah diambil atau tidak tersedia');var order=ksbRow_('ORDERS',d.order_id);ksbRequire_(order&&(d.type==='MARKETPLACE'&&ksbSettingNumber_('marketplace_prepaid_only',1)===1?order.payment_status==='PAID':(order.payment_method==='COD'||order.payment_status==='PAID')),'Pembayaran barang belum terverifikasi: kurir tidak boleh menalangi harga produk');var id=ksbId_('CLM'),now=ksbNow_();ksbPatch_('DELIVERY_ORDERS',d.id,{courier_id:c.id,status:'CLAIMED',updated_at:now});ksbAppend_('COURIER_CLAIMS',{id:id,delivery_id:d.id,courier_id:c.id,status:'ACTIVE',claimed_at:now,picked_up_at:''});ksbHistory_(d.order_id,'DELIVERY:'+d.id,'CLAIMED',actor.id,'Klaim berhasil');ksbAudit_(actor.id,'CLAIM','DELIVERY',d.id,{});return {id:d.id,status:'CLAIMED',buyerWhatsAppUrl:ksbCourierBuyerWaUrl_(actor,d.id)};});}
function ksbUpdateDeliveryStatus_(actor,args){ksbV10RequireCommerce_();var c=ksbOwnCourier_(actor);return ksbWithLock_(function(){var d=ksbRow_('DELIVERY_ORDERS',args.deliveryId);ksbRequire_(d&&d.courier_id===c.id,'Pengiriman bukan milik kurir');var next=String(args.status),allowed={CLAIMED:['HEADING_TO_PICKUP','PICKED_UP'],HEADING_TO_PICKUP:['PICKED_UP'],PICKED_UP:['IN_DELIVERY'],IN_DELIVERY:['DELIVERED','FAILED_DELIVERY']};ksbRequire_((allowed[d.status]||[]).indexOf(next)>=0,'Transisi status tidak sah');var proof='';if(['PICKED_UP','DELIVERED'].indexOf(next)>=0){var a=ksbRow_('FILE_ATTACHMENTS',args.attachmentId);ksbRequire_(a&&a.owner_id===actor.id&&a.entity_type==='DELIVERY'&&a.entity_id===d.id,'Upload bukti untuk pengiriman ini '+next+' terlebih dahulu.');proof=a.file_id;}
  if(next==='DELIVERED'&&d.payment_method==='COD'){ksbRequire_(args.codCollected===true,'Konfirmasi penerimaan uang COD wajib');ksbRequire_(ksbAmount_(args.codAmount,'COD')===Number(d.cod_due),'Nominal COD harus sama dengan tagihan');}
  var patch={status:next,updated_at:ksbNow_()};if(next==='PICKED_UP')patch.proof_pickup_file=proof;if(next==='DELIVERED')patch.proof_delivery_file=proof;
  ksbPatch_('DELIVERY_ORDERS',d.id,patch);if(next==='PICKED_UP'){ksbFilter_('COURIER_CLAIMS',function(x){return x.delivery_id===d.id&&x.courier_id===c.id&&x.status==='ACTIVE';}).forEach(function(x){ksbPatch_('COURIER_CLAIMS',x.id,{picked_up_at:ksbNow_()});});}
  ksbHistory_(d.order_id,'DELIVERY:'+d.id,next,actor.id,'Update kurir');if(next==='DELIVERED')ksbFinalizeDelivery_(d,actor);if(next==='FAILED_DELIVERY'){ksbPatch_('ORDERS',d.order_id,{status:'DISPUTED'});ksbAudit_(actor.id,'FAILED_DELIVERY','DELIVERY',d.id,{requiresResolution:true});}
  return {id:d.id,status:next};});}
function ksbCourierDashboard_(actor){var c=ksbOwnCourier_(actor),orders=ksbFilter_('DELIVERY_ORDERS',function(d){return d.courier_id===c.id;}),earned=orders.reduce(function(sum,d){return sum+(d.status==='DELIVERED'?Number(d.shipping_fee)-Number(d.courier_fee_amount||0):0);},0);return {courier:c,available:ksbFilter_('DELIVERY_ORDERS',function(d){return d.status==='AVAILABLE';}).length,active:orders.filter(function(d){return ['CLAIMED','HEADING_TO_PICKUP','PICKED_UP','IN_DELIVERY'].indexOf(d.status)>=0;}).length,delivered:orders.filter(function(d){return d.status==='DELIVERED';}).length,estimatedEarned:earned,payable:ksbAccountBalance_('PAYABLE_COURIER',actor.id),codOutstanding:ksbFilter_('COD_COLLECTIONS',function(x){return x.courier_id===c.id;}).reduce(function(s,x){return s+Number(x.remaining_amount);},0)};}
