function ksbAdminSettlement_(actor,args){ksbRole_(actor,'ADMIN');ksbRequire_(ksbProperty_('KSB_V7_MANUAL_CLAIMS','0')!=='1','Gunakan tagihan per order V7; settlement langsung dinonaktifkan.');var partyId=ksbString_(args.partyId,90),type=ksbString_(args.partyType,20);ksbRequire_(['SELLER','COURIER'].indexOf(type)>=0,'Jenis mitra tidak valid');ksbRequire_(ksbRow_('USERS',partyId),'Mitra tidak ditemukan');
  var payout=ksbPayoutForParty_(partyId,type);ksbRequire_(payout&&payout.status==='VERIFIED','Rekening pencairan mitra belum diverifikasi.');
  ksbRequire_(args.confirmBankRecipient===true,'Konfirmasi penerima transfer sama dengan rekening mitra yang disetujui.');var amount=ksbAmount_(args.amount,'Settlement');ksbRequire_(amount>0,'Nominal harus positif');return ksbIdempotent_(actor,'SETTLEMENT',args.requestKey,function(){
  var acct=type==='SELLER'?'PAYABLE_SELLER':'PAYABLE_COURIER';ksbRequire_(ksbAccountBalance_(acct,partyId)>=amount,'Saldo hak mitra tidak cukup');ksbRequire_(ksbCashBalance_()>=amount,'Kas platform tidak cukup untuk settlement.');var ref=ksbString_(args.bankReference,100);ksbRequire_(ref,'Referensi bukti transfer wajib');ksbRequire_(!ksbFilter_('SETTLEMENTS',function(s){return s.bank_reference===ref;}).length,'Referensi settlement sudah digunakan');var id=ksbId_('STL');
  ksbJournal_('SETTLEMENT',id,'','Transfer hak mitra',[{account:acct,party_id:partyId,debit:amount},{account:'CASH_PLATFORM',credit:amount}]);ksbAppend_('SETTLEMENTS',{id:id,party_id:partyId,party_type:type,amount:amount,bank_reference:ref,status:'PAID',created_by:actor.id,created_at:ksbNow_()});ksbAudit_(actor.id,'SETTLEMENT','SETTLEMENT',id,{amount:amount});return {id:id,amount:amount,status:'PAID'};
});}
