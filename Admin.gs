function ksbAdminDashboard_(actor){ksbRole_(actor,'ADMIN');var orders=ksbRows_('ORDERS'),payments=ksbRows_('PAYMENTS'),invoices=ksbRows_('INVOICES'),cod=ksbRows_('COD_COLLECTIONS'),ledger=ksbRows_('LEDGER_ENTRIES');function credits_(acc){return ledger.filter(function(r){return r.account===acc;}).reduce(function(n,r){return n+Number(r.credit)-Number(r.debit);},0);}return {gmv:orders.reduce(function(s,o){return s+Number(o.grand_total);},0),orderCount:orders.length,orderActive:orders.filter(function(o){return ['PENDING_PAYMENT','CONFIRMED','PROCESSING','READY','IN_DELIVERY','PARTIALLY_DELIVERED'].indexOf(o.status)>=0;}).length,completed:orders.filter(function(o){return o.status==='DELIVERED';}).length,users:ksbRows_('USERS').length,sellers:ksbRows_('SELLERS').length,couriers:ksbRows_('COURIERS').length,confirmedTransfer:payments.filter(function(p){return p.method==='TRANSFER'&&p.status==='VERIFIED';}).reduce(function(s,p){return s+Number(p.amount);},0),codOutstanding:cod.reduce(function(s,c){return s+Number(c.remaining_amount);},0),sellerPayable:credits_('PAYABLE_SELLER'),courierPayable:credits_('PAYABLE_COURIER'),invoiceOutstanding:invoices.reduce(function(s,i){return s+Number(i.balance);},0),platformRevenue:credits_('REVENUE_SELLER_FEE')+credits_('REVENUE_COURIER_FEE')+credits_('REVENUE_BUYER_FEE')+credits_('PLATFORM_PROMO_EXPENSE'),cash:ksbCashBalance_(),recent:ksbPageSort_(orders,'created_at').slice(0,12)};}
function ksbAdminPending_(actor){ksbRole_(actor,'ADMIN');return ksbFilter_('ROLES',function(r){return r.status==='PENDING';}).map(function(r){return {id:r.id,user:ksbRow_('USERS',r.user_id),role:r.role,status:r.status};});}
function ksbAdminApprove_(actor,args){ksbRole_(actor,'ADMIN');return ksbWithLock_(function(){var r=ksbRow_('ROLES',args.roleId);ksbRequire_(r&&r.status==='PENDING'&&['SELLER','COURIER'].indexOf(r.role)>=0,'Permohonan tidak ditemukan');var approve=args.approve===true;ksbPatch_('ROLES',r.id,{status:approve?'APPROVED':'REJECTED'});if(r.role==='SELLER'){var s=ksbFilter_('SELLERS',function(x){return x.user_id===r.user_id;})[0];if(s)ksbPatch_('SELLERS',s.id,{verified:approve?'TRUE':'FALSE'});}else{var c=ksbFilter_('COURIERS',function(x){return x.user_id===r.user_id;})[0];if(c)ksbPatch_('COURIERS',c.id,{verified:approve?'TRUE':'FALSE'});}ksbAudit_(actor.id,approve?'APPROVE_ROLE':'REJECT_ROLE','ROLE',r.id,{});return {status:approve?'APPROVED':'REJECTED'};});}
function ksbAdminSettings_(actor){ksbRole_(actor,'ADMIN');return {settings:ksbRows_('APP_SETTINGS'),zones:ksbRows_('DELIVERY_ZONES'),districts:ksbRows_('DISTRICTS')};}
function ksbAdminSaveSetting_(actor,args){ksbRole_(actor,'ADMIN');return ksbWithLock_(function(){var name=ksbString_(args.key,80),allowed=['delivery_base','delivery_per_km','delivery_min','delivery_per_extra_kg','delivery_express_extra','delivery_interdistrict_extra','delivery_basket_percent','delivery_basket_cap','buyer_fee','seller_fee_percent','courier_fee_percent','max_package_kg'];ksbRequire_(allowed.indexOf(name)>=0,'Pengaturan tidak valid');var val=ksbAmount_(args.value,'Nilai');if(name.indexOf('percent')>=0)ksbRequire_(val<=100,'Persentase maksimum 100');var row=ksbFilter_('APP_SETTINGS',function(s){return s.key===name;})[0];ksbRequire_(row,'Pengaturan belum dipasang');ksbPatch_('APP_SETTINGS',row.id,{value:val,updated_at:ksbNow_()});ksbAudit_(actor.id,'SETTING','APP_SETTINGS',row.id,{key:name,value:val});return {key:name,value:val};});}
function ksbAdminSaveZone_(actor,args){ksbRole_(actor,'ADMIN');return ksbWithLock_(function(){ksbRequire_(ksbRow_('DISTRICTS',args.from)&&ksbRow_('DISTRICTS',args.to),'Kecamatan tidak dikenal');var tariff=ksbAmount_(args.tariff,'Tarif zona');ksbRequire_(tariff>0,'Tarif zona harus positif');var zone=ksbFilter_('DELIVERY_ZONES',function(z){return z.from_district===args.from&&z.to_district===args.to;})[0];if(zone)return ksbPatch_('DELIVERY_ZONES',zone.id,{fixed_tariff:tariff,active:'TRUE'});return ksbAppend_('DELIVERY_ZONES',{id:ksbId_('ZONE'),from_district:args.from,to_district:args.to,fixed_tariff:tariff,active:'TRUE',created_at:ksbNow_()});});}
function ksbAdminOrders_(actor,args){ksbRole_(actor,'ADMIN');return ksbPagination_(ksbPageSort_(ksbRows_('ORDERS'),'created_at'),args);}
function ksbAdminDisputes_(actor,args){ksbRole_(actor,'ADMIN');return ksbPagination_(ksbPageSort_(ksbFilter_('ORDERS',function(o){return o.status==='DISPUTED';}),'created_at'),args);}

function ksbAdminUsers_(actor){ksbRole_(actor,'ADMIN');return ksbRows_('USERS').map(function(u){return {id:u.id,name:u.display_name,email:u.email,roles:ksbFilter_('ROLES',function(r){return r.user_id===u.id&&r.status==='APPROVED';}).map(function(r){return r.role;})};});}

function ksbAdminBillingCycle_(actor,args){ksbRole_(actor,'ADMIN');var role=ksbString_(args.partyType,20),cycle=ksbString_(args.cycle,20);ksbRequire_(['SELLER','COURIER'].indexOf(role)>=0&&['DAILY','WEEKLY','MONTHLY'].indexOf(cycle)>=0,'Siklus tidak valid');var table=role==='SELLER'?'SELLERS':'COURIERS',p=ksbFilter_(table,function(r){return r.user_id===args.partyId;})[0];ksbRequire_(p,'Mitra tidak ditemukan');return ksbWithLock_(function(){ksbPatch_(table,p.id,{billing_cycle:cycle});ksbAudit_(actor.id,'BILLING_CYCLE',table,p.id,{cycle:cycle});return {cycle:cycle};});}
