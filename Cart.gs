function ksbCartFor_(userId){var cart=ksbFilter_('CARTS',function(c){return c.user_id===userId;})[0];if(cart)return cart;return ksbAppend_('CARTS',{id:ksbId_('CRT'),user_id:userId,created_at:ksbNow_(),updated_at:ksbNow_()});}
function ksbCartGet_(actor){var cart=ksbCartFor_(actor.id),items=ksbFilter_('CART_ITEMS',function(i){return i.cart_id===cart.id&&Number(i.quantity)>0;});var total=0,lines=items.map(function(i){var p=ksbRow_('PRODUCTS',i.product_id),s=p?ksbRow_('SELLER_STORES',p.store_id):null;var line=p?Number(p.price)*Number(i.quantity):0;total+=line;return {id:i.id,product_id:i.product_id,name:p?p.name:'Produk dihapus',quantity:Number(i.quantity),price:p?Number(p.price):0,stock:p?Number(p.stock):0,store_id:p?p.store_id:'',store_name:s?s.name:'',store_district:s?s.district_id:'',store_address:s?s.address:'',store_lat:s?s.lat:'',store_lng:s?s.lng:'',line_total:line,active:!!p&&ksbBool_(p.active)};});return {items:lines,total:total};}
function ksbCartAdd_(actor,args){return ksbWithLock_(function(){var p=ksbRow_('PRODUCTS',args.product_id);ksbRequire_(p&&ksbBool_(p.active),'Produk tidak tersedia');var qty=ksbAmount_(args.quantity||1,'Kuantitas');ksbRequire_(qty>0&&qty<=999,'Jumlah tidak valid');var cart=ksbCartFor_(actor.id),old=ksbFilter_('CART_ITEMS',function(i){return i.cart_id===cart.id&&i.product_id===p.id;})[0],newQty=qty+(old?Number(old.quantity):0);ksbRequire_(newQty<=Number(p.stock),'Stok tidak cukup');if(old)ksbPatch_('CART_ITEMS',old.id,{quantity:newQty});else ksbAppend_('CART_ITEMS',{id:ksbId_('CI'),cart_id:cart.id,product_id:p.id,variant_id:'',quantity:newQty,created_at:ksbNow_()});return ksbCartGet_(actor);});}
function ksbCartUpdate_(actor,args){return ksbWithLock_(function(){var cart=ksbCartFor_(actor.id),item=ksbRow_('CART_ITEMS',args.id);ksbRequire_(item&&item.cart_id===cart.id,'Item tidak valid');var qty=ksbAmount_(args.quantity,'Jumlah');var p=ksbRow_('PRODUCTS',item.product_id);ksbRequire_(qty>=1&&p&&qty<=Number(p.stock),'Kuantitas melewati stok');ksbPatch_('CART_ITEMS',item.id,{quantity:qty});return ksbCartGet_(actor);});}
function ksbCartRemove_(actor,args){return ksbWithLock_(function(){var cart=ksbCartFor_(actor.id),i=ksbRow_('CART_ITEMS',args.id);ksbRequire_(i&&i.cart_id===cart.id,'Item tidak ditemukan');ksbPatch_('CART_ITEMS',i.id,{quantity:0});return ksbCartGet_(actor);});}
