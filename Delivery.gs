function ksbCreateParcel_(actor,args){ksbRole_(actor,'BUYER');return ksbIdempotent_(actor,'CREATE_PARCEL',args.requestKey,function(){
  var sender=ksbRow_('ADDRESSES',args.senderAddressId),recipient=ksbRow_('ADDRESSES',args.recipientAddressId);
  ksbRequire_(sender&&recipient&&sender.user_id===actor.id&&recipient.user_id===actor.id,'Alamat pengirim/penerima tidak sah.');
  var payment=String(args.paymentMethod);ksbRequire_(['COD','TRANSFER'].indexOf(payment)>=0,'Metode pembayaran tidak didukung');if(payment==='TRANSFER')ksbRequire_(ksbProperty_('BANK_NUMBER')&&ksbProperty_('BANK_NAME')&&ksbProperty_('BANK_HOLDER'),'Rekening platform belum dikonfigurasi.');
  var weight=Number(args.weight);ksbRequire_(weight>0&&weight<=ksbSettingNumber_('max_package_kg',25),'Berat paket tidak valid');
  var quote=ksbDeliveryQuote_({fromDistrict:sender.district_id,toDistrict:recipient.district_id,fromLat:sender.lat,fromLng:sender.lng,toLat:recipient.lat,toLng:recipient.lng,weight:weight,service:args.service});
  ksbRequire_(quote.available,'Tarif belum tersedia: '+quote.message);ksbRequire_(!quote.requiresConsent||args.acceptZoneTariff===true,'Setujui tarif zona.');
  var fee=ksbSettingNumber_('buyer_fee',2000),total=quote.fee+fee,o=ksbId_('ORD'),d=ksbId_('DLV'),now=ksbNow_();
  ksbAppend_('ORDERS',{id:o,buyer_id:actor.id,address_id:recipient.id,payment_method:payment,payment_status:payment==='COD'?'COD_PENDING':'WAITING_TRANSFER',status:payment==='COD'?'CONFIRMED':'PENDING_PAYMENT',subtotal:0,discount:0,shipping_total:quote.fee,buyer_fee:fee,grand_total:total,voucher_id:'',created_at:now,updated_at:now});
  ksbAppend_('DELIVERY_ORDERS',{id:d,order_id:o,seller_order_id:'',type:'PARCEL',sender_id:actor.id,recipient_id:actor.id,pickup_address:sender.address,dropoff_address:recipient.address,sender_phone:sender.phone,recipient_phone:recipient.phone,pickup_lat:sender.lat,pickup_lng:sender.lng,dropoff_lat:recipient.lat,dropoff_lng:recipient.lng,from_district:sender.district_id,to_district:recipient.district_id,route_distance_m:quote.distance_m===null?'':quote.distance_m,route_duration_s:quote.duration_s===null?'':quote.duration_s,shipping_fee:quote.fee,courier_fee_amount:Math.floor(quote.fee*ksbSettingNumber_('courier_fee_percent',10)/100),payment_method:payment,cod_due:payment==='COD'?total:0,status:payment==='COD'?'AVAILABLE':'WAITING_SELLER',created_at:now,updated_at:now});
  ksbAppend_('PAYMENTS',{id:ksbId_('PAY'),order_id:o,method:payment,reference:ksbId_('REF'),amount:total,status:payment==='COD'?'COD_AWAITING_DELIVERY':'PENDING',created_at:now});
  ksbHistory_(o,'ORDER',payment==='COD'?'CONFIRMED':'PENDING_PAYMENT',actor.id,'Paket dibuat');return {id:o,deliveryId:d,total:total,quote:quote,bank:{name:ksbProperty_('BANK_NAME'),number:ksbProperty_('BANK_NUMBER'),holder:ksbProperty_('BANK_HOLDER')}};
});}
function ksbMyParcels_(actor,args){var os=ksbFilter_('ORDERS',function(o){return o.buyer_id===actor.id;}).map(function(o){return o.id;});return ksbPagination_(ksbPageSort_(ksbFilter_('DELIVERY_ORDERS',function(d){return d.type==='PARCEL'&&os.indexOf(d.order_id)>=0;}),'created_at'),args);}
function ksbTrack_(actor,args){var d=ksbRow_('DELIVERY_ORDERS',args.deliveryId);ksbRequire_(d,'Pengiriman tidak ditemukan');var o=ksbRow_('ORDERS',d.order_id),courier=d.courier_id?ksbRow_('COURIERS',d.courier_id):null,store=d.seller_order_id?ksbRow_('SELLER_ORDERS',d.seller_order_id):null,owner=store?ksbRow_('SELLER_STORES',store.store_id):null,seller=owner?ksbRow_('SELLERS',owner.seller_id):null;
  ksbRequire_(o.buyer_id===actor.id||courier&&courier.user_id===actor.id||seller&&seller.user_id===actor.id||actor.roles.indexOf('ADMIN')>=0,'Tidak berwenang melacak paket.');
  var courierUser=courier?ksbRow_('USERS',courier.user_id):null;return {delivery:ksbDeliverySafe_(d),courier:courierUser?{name:courierUser.display_name,phone:courier.phone}:null,history:ksbFilter_('ORDER_STATUS_HISTORY',function(h){return h.order_id===d.order_id&&h.entity==='DELIVERY:'+d.id;}),tracking_mode:'STATUS_ONLY',location_updated_at:null,eta_seconds:null};
}
